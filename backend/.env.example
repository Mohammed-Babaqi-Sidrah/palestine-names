# OpenRouter API Key for Palestine Names Archive LangChain Agent
# Get your free/paid key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Names sync: checked on startup and every 24 hours; offline fallback stays usable.
DATA_SYNC_ENABLED=true
# Optional writable persistent volume location:
# DATA_CACHE_PATH=/var/lib/palestine-names/names.json
